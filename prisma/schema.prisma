// =============================================================================
// IMAGECRAFTER DATABASE SCHEMA
// Credit-Based Pricing System (Shared Blogcraft Database with ic_ prefix)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER & AUTHENTICATION (Synced from Clerk)
// =============================================================================

model User {
  id                String   @id // Clerk user_id (e.g., "user_2abc123...")
  email             String   @unique
  firstName         String?
  lastName          String?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Stripe integration
  stripeCustomerId  String?  @unique

  // Relations
  subscription      Subscription?
  projects          Project[]
  images            Image[]
  generationRequests GenerationRequest[]
  prompts           PromptHistory[]
  usageRecords      UsageRecord[]
  reviews           Review[]
  portraits         Portrait[]
  orders            Order[]
  creditLedger      CreditLedger[]

  @@index([email])
  @@index([stripeCustomerId])
  @@map("ic_User")
}

// =============================================================================
// SUBSCRIPTION & BILLING (Credit-Based System)
// =============================================================================

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe fields
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  stripeStatus           SubscriptionStatus @default(ACTIVE)

  // Plan details
  plan                   PlanTier           @default(FREE)

  // ============ Credit System ============
  creditsLimit           Int                @default(10)
  creditsUsed            Int                @default(0)
  creditsResetAt         DateTime           @default(now())
  maxResolution          String             @default("1K")

  // Feature flags
  hasProjects            Boolean            @default(false)
  hasBatchMode           Boolean            @default(false)
  hasApiAccess           Boolean            @default(false)
  hasWatermark           Boolean            @default(true)
  hasPriorityQueue       Boolean            @default(false)

  // ============ LEGACY ============
  monthlyImageLimit      Int                @default(5)
  imagesUsedThisPeriod   Int                @default(0)
  canUsePro              Boolean            @default(false)
  canUseBatch            Boolean            @default(false)
  canUse4K               Boolean            @default(false)
  canUseProjects         Boolean            @default(false)
  maxProjectCount        Int                @default(0)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([stripeStatus])
  @@map("ic_Subscription")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  UNPAID
  PAUSED

  @@map("ic_SubscriptionStatus")
}

// Tier collapse (Amendment A3, founder-resolved 2026-07-05): Free / Pro only.
// Existing STARTER/TEAM rows are explicitly mapped to PRO (grandfathered) in
// prisma/migrations/20260705_generation_request_dual_engine_tier_collapse.sql
enum PlanTier {
  FREE
  PRO

  @@map("ic_PlanTier")
}

// =============================================================================
// PROJECTS
// =============================================================================

enum ProjectType {
  GENERAL
  CHILDRENS_BOOK
  STORYBOARD
  PRESENTATION
  SOCIAL_MEDIA_CAMPAIGN
  BRAND_ASSETS
  PRODUCT_LINE

  @@map("ic_ProjectType")
}

model Project {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  projectType       ProjectType     @default(GENERAL)

  stylePreset       String?
  colorPalette      String[]
  aspectRatio       String          @default("16:9")

  characterProfile  CharacterProfile?
  images            Image[]

  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([projectType])
  @@map("ic_Project")
}

// =============================================================================
// CHARACTER PROFILE
// =============================================================================

model CharacterProfile {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name              String
  description       String   @db.Text

  anchorImageId     String?  @unique
  anchorImage       Image?   @relation("AnchorImage", fields: [anchorImageId], references: [id])

  physicalTraits    Json?
  clothing          Json?
  styleNotes        String?

  analysisModel     String?
  analysisVersion   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("ic_CharacterProfile")
}

// =============================================================================
// GENERATION REQUESTS (one request -> N Image children -> user picks winner)
// =============================================================================
//
// The image-gen service (image-gen.xencolabs.com) can return one image
// (POST /api/v1/generate — Free flow) or up to two provider results
// (POST /api/v1/dual/generate — Pro flow). N is NOT guaranteed to be 2:
// a provider slot can fail while the other succeeds (status PARTIAL), or the
// whole call can fail (status FAILED, credits refunded). Persist exactly what
// the service returned — never fabricate a missing image.

enum GenerationMode {
  SINGLE
  DUAL

  @@map("ic_GenerationMode")
}

enum GenerationRequestStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED

  @@map("ic_GenerationRequestStatus")
}

model GenerationRequest {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode            GenerationMode          @default(SINGLE)
  status          GenerationRequestStatus @default(PENDING)

  prompt          String                  @db.Text
  enhancedPrompt  String?                 @db.Text
  aspectRatio     String                  @default("1:1")
  resolution      String                  @default("1K")

  // Credits actually charged for this request (after any partial/total refund)
  creditsCharged  Int                     @default(0)
  errorMessage    String?
  totalLatencyMs  Int?

  // The image the user picked as the winner (dual flow)
  selectedImageId String?                 @unique
  selectedImage   Image?                  @relation("GenerationRequestSelectedImage", fields: [selectedImageId], references: [id], onDelete: SetNull)

  images          Image[]

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("ic_GenerationRequest")
}

// =============================================================================
// IMAGES
// =============================================================================

model Image {
  id                String        @id @default(cuid())
  externalId        String?       @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  imageUrl          String
  thumbnailUrl      String?
  width             Int           @default(1024)
  height            Int           @default(1024)

  originalPrompt    String        @db.Text
  enhancedPrompt    String?       @db.Text
  negativePrompt    String?       @db.Text
  aspectRatio       String        @default("1:1")

  resolution        String        @default("1K")
  creditsCost       Int           @default(1)

  model             String        @default("gemini-2.0-flash")
  usedPro           Boolean       @default(false)
  styleHints        String?
  seed              Int?
  modelVersion      String?
  generationTime    Int?

  // Provider metadata from the image-gen service response
  // (externalId above holds the service's external_id)
  provider          String?       // "gemini" | "openai" as reported by the service
  providerLatencyMs Int?          // latency_ms from the service response
  estimatedCostUsd  Float?        // estimated_cost_usd from the service response

  generationRequestId String?
  generationRequest   GenerationRequest? @relation(fields: [generationRequestId], references: [id], onDelete: SetNull)
  selectedForRequest  GenerationRequest? @relation("GenerationRequestSelectedImage")

  templateId        String?
  template          Template?     @relation(fields: [templateId], references: [id])
  presetId          String?
  preset            TemplatePreset? @relation(fields: [presetId], references: [id])

  characterId       String?
  characterInjected Boolean       @default(false)

  status            ImageStatus   @default(COMPLETED)
  isWatermarked     Boolean       @default(false)
  hasWatermark      Boolean       @default(false)
  isFavorite        Boolean       @default(false)
  isPublic          Boolean       @default(false)

  anchoredProfile   CharacterProfile? @relation("AnchorImage")

  generatedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  expiresAt         DateTime?
  deletedAt         DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([generatedAt])
  @@index([status])
  @@index([generationRequestId])
  @@map("ic_Image")
}

enum ImageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED

  @@map("ic_ImageStatus")
}

// =============================================================================
// PROMPT HISTORY
// =============================================================================

model PromptHistory {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt            String    @default("") @db.Text
  originalPrompt    String?   @db.Text
  enhancedPrompt    String?   @db.Text

  templateId        String?
  templateSlug      String?
  presetId          String?
  projectId         String?

  aspectRatio       String?
  resolution        String?
  model             String?
  styleHints        String?

  imageId           String?
  wasSuccessful     Boolean   @default(true)
  errorMessage      String?

  timesUsed         Int       @default(1)
  lastUsedAt        DateTime  @default(now())
  isSaved           Boolean   @default(false)

  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([isSaved])
  @@index([createdAt])
  @@index([lastUsedAt])
  @@map("ic_PromptHistory")
}

// =============================================================================
// TEMPLATES
// =============================================================================

enum TemplateCategory {
  BLOG_IMAGES
  SOCIAL_MEDIA
  PRESENTATIONS
  STORYTELLING
  PRODUCT_MARKETING
  PROFILE_BACKGROUNDS
  INFOGRAPHICS
  CUSTOM

  @@map("ic_TemplateCategory")
}

model Template {
  id                String           @id @default(cuid())
  slug              String           @unique

  name              String
  description       String?
  category          TemplateCategory
  iconName          String?

  promptTemplate    String           @db.Text
  defaultStyleHints String?
  defaultAspectRatio String          @default("16:9")

  examplePrompt     String?          @db.Text
  exampleImageUrl   String?

  presets           TemplatePreset[]
  images            Image[]

  usageCount        Int              @default(0)
  isActive          Boolean          @default(true)
  isPremium         Boolean          @default(false)
  isPro             Boolean          @default(false)
  sortOrder         Int              @default(0)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("ic_Template")
}

model TemplatePreset {
  id                String    @id @default(cuid())
  templateId        String
  template          Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  slug              String
  name              String
  description       String?

  styleOverrides    Json?
  promptSuffix      String?   @db.Text
  promptPrefix      String?   @db.Text
  styleKeywords     String?   @db.Text

  previewUrl        String?
  exampleImageUrl   String?

  isPro             Boolean   @default(false)
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)

  images            Image[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@unique([templateId, slug])
  @@map("ic_TemplatePreset")
}

// =============================================================================
// USAGE TRACKING
// =============================================================================

model UsageRecord {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  action              String       @default("generate")
  imageId             String?

  creditsUsed         Int          @default(1)
  resolution          String?
  wasProModel         Boolean      @default(false)

  estimatedCost       Float?

  billingPeriodStart  DateTime?
  billingPeriodEnd    DateTime?

  apiLatencyMs        Int?
  apiModel            String?

  createdAt           DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("ic_UsageRecord")
}

// =============================================================================
// BATCH JOBS
// =============================================================================

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  PARTIAL_FAILURE
  FAILED

  @@map("ic_BatchStatus")
}

model BatchJob {
  id                String      @id @default(cuid())
  userId            String

  prompt            String?     @db.Text
  templateId        String?
  presetId          String?
  resolution        String      @default("1K")

  totalImages       Int         @default(1)
  count             Int         @default(1)
  completedImages   Int         @default(0)
  completedCount    Int         @default(0)
  failedImages      Int         @default(0)
  failedCount       Int         @default(0)

  creditsReserved   Int         @default(0)
  creditsUsed       Int         @default(0)

  status            BatchStatus @default(PENDING)
  errorMessage      String?

  prompts           Json?
  sharedSettings    Json?
  imageIds          String[]
  errors            Json?

  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("ic_BatchJob")
}

// =============================================================================
// REVIEWS
// =============================================================================

model Review {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating          Int
  title           String
  content         String    @db.Text
  useCase         String?

  isApproved      Boolean   @default(false)
  isPublic        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("ic_Review")
}

// =============================================================================
// WAITLIST
// =============================================================================

model WaitlistEntry {
  id                String   @id @default(cuid())
  email             String   @unique
  source            String?
  referralCode      String?

  interestedIn      String[]

  isInvited         Boolean  @default(false)
  invitedAt         DateTime?
  convertedToUser   Boolean  @default(false)

  createdAt         DateTime @default(now())

  @@index([email])
  @@index([isInvited])
  @@map("ic_WaitlistEntry")
}

// =============================================================================
// PORTRAIT STUDIO MODELS
// =============================================================================

model Portrait {
  id                String    @id @default(cuid())
  userId            String?   // nullable — guest portraits have no user
  sessionId         String    // browser session ID for guest tracking
  sourceImageUrl    String    // original uploaded photo (S3/R2)
  sourceImageKey    String    // storage key for cleanup
  previewImageUrl   String?   // watermarked preview (generated)
  hiResImageUrl     String?   // full-res, unwatermarked (generated)
  stylePackSlug     String    // FK to StylePack.slug
  styleVariantSlug  String    // specific variant within the pack
  subjectType       String    // "pet" | "person" | "couple" | "family" | "group"
  subjectAnalysis   Json      // Claude Vision output (features, description)
  enhancedPrompt    String    // final prompt sent to Gemini
  status            String    @default("pending") // pending | analyzing | generating | preview | purchased | failed
  errorMessage      String?   // populated on failure
  // Acceptance-gate result: { identity, style, ip, pass, swapAttempts }.
  // RECORDED, not enforced — a failing verdict no longer blocks delivery, so
  // this is the only trace of what the gate thought. Null on portraits that
  // never reached the gate.
  gateVerdict       Json?
  generationTimeMs  Int?      // track performance
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User?     @relation(fields: [userId], references: [id])
  order             Order?

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("ic_Portrait")
}

model Order {
  id                String    @id @default(cuid())
  portraitId        String    @unique
  userId            String?   // nullable for guest orders
  email             String    // always required — guest provides at checkout
  name              String?   // customer name for shipping
  type              String    // "digital" | "print"

  // Digital delivery
  downloadUrl       String?   // secure, time-limited download link
  downloadCount     Int       @default(0)
  maxDownloads      Int       @default(5)
  downloadExpiresAt DateTime? // link expiry

  // Print fulfillment (Prodigi)
  printProductSku   String?   // Prodigi product SKU
  printSize         String?   // "8x10", "12x16", "16x20", "24x36"
  printFrame        String?   // "none", "black", "white", "natural", "gold", "silver"
  printFormat       String?   // "canvas", "framed_print", "art_print"
  prodigiOrderId    String?   // Prodigi's order reference
  prodigiStatus     String?   // Prodigi fulfillment status
  trackingNumber    String?   // shipping tracking
  trackingUrl       String?   // carrier tracking URL

  // Shipping address (print orders only)
  shippingName      String?
  shippingLine1     String?
  shippingLine2     String?
  shippingCity      String?
  shippingState     String?
  shippingZip       String?
  shippingCountry   String?

  // Payment
  stripePaymentIntentId  String?
  stripeSessionId        String?
  amount                 Int       // total in cents
  currency               String    @default("usd")
  status                 String    @default("pending") // pending | paid | fulfilled | shipped | delivered | refunded | failed

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  portrait          Portrait  @relation(fields: [portraitId], references: [id])
  user              User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([prodigiOrderId])
  @@map("ic_Order")
}

// Purchased portrait credits (packs). Append-only ledger — balance is
// SUM(delta), computed in a transaction. Separate from Subscription's
// monthly-reset credits: pack credits never expire (founder decision 2026-08-14).
model CreditLedger {
  id              String   @id @default(cuid())
  userId          String
  delta           Int      // +N on pack grant, -1 on redemption
  reason          String   // "pack_grant" | "portrait_redeem" | "refund" | "admin_adjust"
  stripeSessionId String?  @unique // idempotency key for pack grants (webhook replays)
  orderId         String?  // Order created/updated by a redemption
  portraitId      String?
  packSku         String?  // "PACK_3" | "PACK_10" | "PACK_25"
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("ic_CreditLedger")
}

// Contacts pushed to Mautic, including the failures. Its own table rather than
// a flag on Order because pack purchases never create an Order row, and a
// previewer has no order at all — both still have to stay queryable for retry.
//
// dedupeKey is the natural key per stage: "stripe:<session>" for a buyer (guards
// webhook replays), "preview:<email>" for a previewer (one capture per address).
model MauticCapture {
  id String @id @default(cuid())

  dedupeKey String @unique

  stage        String   @default("buyer") // "previewer" | "buyer"
  email        String
  name         String?  // kept so a retry can replay the original push
  status       String   // "captured" | "failed"
  contactId    Int?     // Mautic contact id once the push lands
  attempts     Int      @default(0)
  lastError    String?
  purchaseType String?  // "digital" | "print" | "pack" — null for previewers
  subjectType  String?  // "pet" | "person" | "couple" | "family" | "group"
  style        String?
  previewUrl   String?  // win-back drip beat 1 re-shows the preview
  orderId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("ic_MauticCapture")
}

// One row per preview generation attempt. This is the server-side anchor for
// the preview gate: cookies clear, so the free-preview count is keyed on the
// session AND the IP, and the daily spend cap is counted from here rather than
// trusted from the client.
//
// "blocked" rows are refusals — they do not consume the caller's quota, but
// they do count toward the velocity signal that trips the captcha.
model PreviewUsage {
  id         String   @id @default(cuid())
  sessionId  String
  ip         String
  email      String?  // captured at preview #2; null on the free first preview
  portraitId String
  status     String   @default("allowed") // "allowed" | "blocked"
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("ic_PreviewUsage")
}

model StylePack {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String    // display name
  tagline         String    // short hook for the card
  description     String    // longer description for the detail view
  category        String    // "classic" | "masterpiece" | "time-travel" | "fantasy" | "pop-culture" | "fine-art"
  sortOrder       Int       @default(0)
  thumbnailUrl    String    // hero image for the pack card
  isActive        Boolean   @default(true)
  isPremium       Boolean   @default(false) // Pro subscribers or higher per-portrait price
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  variants        StyleVariant[]

  @@index([category])
  @@index([isActive])
  @@map("ic_StylePack")
}

model StyleVariant {
  id              String    @id @default(cuid())
  stylePackId     String
  slug            String    // unique within parent pack
  name            String    // display name
  description     String    // what this variant produces
  promptTemplate  String    @db.Text // full prompt template with {{subject}} and {{style_modifiers}}
  styleModifiers  Json      // default modifiers for this variant
  sampleImageUrl  String    // example output for preview
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stylePack       StylePack @relation(fields: [stylePackId], references: [id], onDelete: Cascade)

  @@unique([stylePackId, slug])
  @@index([stylePackId])
  @@map("ic_StyleVariant")
}

// =============================================================================
// BLOG MODELS
// =============================================================================

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String    // for meta description + cards
  content         String    @db.Text // MDX or HTML
  coverImageUrl   String?
  categoryId      String?
  tags            String[]  // array of tag strings
  status          String    @default("draft") // draft | published | archived
  publishedAt     DateTime?
  metaTitle       String?   // SEO override
  metaDescription String?   // SEO override
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@map("ic_BlogPost")
}

model BlogCategory {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  description     String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts           BlogPost[]

  @@map("ic_BlogCategory")
}
