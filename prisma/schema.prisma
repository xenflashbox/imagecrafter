// =============================================================================
// IMAGECRAFTER DATABASE SCHEMA
// Credit-Based Pricing System (Shared Blogcraft Database with ic_ prefix)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER & AUTHENTICATION (Synced from Clerk)
// =============================================================================

model User {
  id                String   @id // Clerk user_id (e.g., "user_2abc123...")
  email             String   @unique
  firstName         String?
  lastName          String?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Stripe integration
  stripeCustomerId  String?  @unique

  // Relations
  subscription      Subscription?
  projects          Project[]
  images            Image[]
  prompts           PromptHistory[]
  usageRecords      UsageRecord[]
  reviews           Review[]

  @@index([email])
  @@index([stripeCustomerId])
  @@map("ic_User")
}

// =============================================================================
// SUBSCRIPTION & BILLING (Credit-Based System)
// =============================================================================

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe fields
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  stripeStatus           SubscriptionStatus @default(ACTIVE)

  // Plan details
  plan                   PlanTier           @default(FREE)

  // ============ Credit System ============
  creditsLimit           Int                @default(10)
  creditsUsed            Int                @default(0)
  creditsResetAt         DateTime           @default(now())
  maxResolution          String             @default("1K")

  // Feature flags
  hasProjects            Boolean            @default(false)
  hasBatchMode           Boolean            @default(false)
  hasApiAccess           Boolean            @default(false)
  hasWatermark           Boolean            @default(true)
  hasPriorityQueue       Boolean            @default(false)

  // ============ LEGACY ============
  monthlyImageLimit      Int                @default(5)
  imagesUsedThisPeriod   Int                @default(0)
  canUsePro              Boolean            @default(false)
  canUseBatch            Boolean            @default(false)
  canUse4K               Boolean            @default(false)
  canUseProjects         Boolean            @default(false)
  maxProjectCount        Int                @default(0)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([stripeStatus])
  @@map("ic_Subscription")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  UNPAID
  PAUSED

  @@map("ic_SubscriptionStatus")
}

enum PlanTier {
  FREE
  STARTER
  PRO
  TEAM

  @@map("ic_PlanTier")
}

// =============================================================================
// PROJECTS
// =============================================================================

enum ProjectType {
  GENERAL
  CHILDRENS_BOOK
  STORYBOARD
  PRESENTATION
  SOCIAL_MEDIA_CAMPAIGN
  BRAND_ASSETS
  PRODUCT_LINE

  @@map("ic_ProjectType")
}

model Project {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  projectType       ProjectType     @default(GENERAL)

  stylePreset       String?
  colorPalette      String[]
  aspectRatio       String          @default("16:9")

  characterProfile  CharacterProfile?
  images            Image[]

  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([projectType])
  @@map("ic_Project")
}

// =============================================================================
// CHARACTER PROFILE
// =============================================================================

model CharacterProfile {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name              String
  description       String   @db.Text

  anchorImageId     String?  @unique
  anchorImage       Image?   @relation("AnchorImage", fields: [anchorImageId], references: [id])

  physicalTraits    Json?
  clothing          Json?
  styleNotes        String?

  analysisModel     String?
  analysisVersion   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("ic_CharacterProfile")
}

// =============================================================================
// IMAGES
// =============================================================================

model Image {
  id                String        @id @default(cuid())
  externalId        String?       @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  imageUrl          String
  thumbnailUrl      String?
  width             Int           @default(1024)
  height            Int           @default(1024)

  originalPrompt    String        @db.Text
  enhancedPrompt    String?       @db.Text
  negativePrompt    String?       @db.Text
  aspectRatio       String        @default("1:1")

  resolution        String        @default("1K")
  creditsCost       Int           @default(1)

  model             String        @default("gemini-2.0-flash")
  usedPro           Boolean       @default(false)
  styleHints        String?
  seed              Int?
  modelVersion      String?
  generationTime    Int?

  templateId        String?
  template          Template?     @relation(fields: [templateId], references: [id])
  presetId          String?
  preset            TemplatePreset? @relation(fields: [presetId], references: [id])

  characterId       String?
  characterInjected Boolean       @default(false)

  status            ImageStatus   @default(COMPLETED)
  isWatermarked     Boolean       @default(false)
  hasWatermark      Boolean       @default(false)
  isFavorite        Boolean       @default(false)
  isPublic          Boolean       @default(false)

  anchoredProfile   CharacterProfile? @relation("AnchorImage")

  generatedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  expiresAt         DateTime?
  deletedAt         DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([generatedAt])
  @@index([status])
  @@map("ic_Image")
}

enum ImageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED

  @@map("ic_ImageStatus")
}

// =============================================================================
// PROMPT HISTORY
// =============================================================================

model PromptHistory {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt            String    @default("") @db.Text
  originalPrompt    String?   @db.Text
  enhancedPrompt    String?   @db.Text

  templateId        String?
  templateSlug      String?
  presetId          String?
  projectId         String?

  aspectRatio       String?
  resolution        String?
  model             String?
  styleHints        String?

  imageId           String?
  wasSuccessful     Boolean   @default(true)
  errorMessage      String?

  timesUsed         Int       @default(1)
  lastUsedAt        DateTime  @default(now())
  isSaved           Boolean   @default(false)

  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([isSaved])
  @@index([createdAt])
  @@index([lastUsedAt])
  @@map("ic_PromptHistory")
}

// =============================================================================
// TEMPLATES
// =============================================================================

enum TemplateCategory {
  BLOG_IMAGES
  SOCIAL_MEDIA
  PRESENTATIONS
  STORYTELLING
  PRODUCT_MARKETING
  PROFILE_BACKGROUNDS
  INFOGRAPHICS
  CUSTOM

  @@map("ic_TemplateCategory")
}

model Template {
  id                String           @id @default(cuid())
  slug              String           @unique

  name              String
  description       String?
  category          TemplateCategory
  iconName          String?

  promptTemplate    String           @db.Text
  defaultStyleHints String?
  defaultAspectRatio String          @default("16:9")

  examplePrompt     String?          @db.Text
  exampleImageUrl   String?

  presets           TemplatePreset[]
  images            Image[]

  usageCount        Int              @default(0)
  isActive          Boolean          @default(true)
  isPremium         Boolean          @default(false)
  isPro             Boolean          @default(false)
  sortOrder         Int              @default(0)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("ic_Template")
}

model TemplatePreset {
  id                String    @id @default(cuid())
  templateId        String
  template          Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  slug              String
  name              String
  description       String?

  styleOverrides    Json?
  promptSuffix      String?   @db.Text
  promptPrefix      String?   @db.Text
  styleKeywords     String?   @db.Text

  previewUrl        String?
  exampleImageUrl   String?

  isPro             Boolean   @default(false)
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)

  images            Image[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@unique([templateId, slug])
  @@map("ic_TemplatePreset")
}

// =============================================================================
// USAGE TRACKING
// =============================================================================

model UsageRecord {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  action              String       @default("generate")
  imageId             String?

  creditsUsed         Int          @default(1)
  resolution          String?
  wasProModel         Boolean      @default(false)

  estimatedCost       Float?

  billingPeriodStart  DateTime?
  billingPeriodEnd    DateTime?

  apiLatencyMs        Int?
  apiModel            String?

  createdAt           DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("ic_UsageRecord")
}

// =============================================================================
// BATCH JOBS
// =============================================================================

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  PARTIAL_FAILURE
  FAILED

  @@map("ic_BatchStatus")
}

model BatchJob {
  id                String      @id @default(cuid())
  userId            String

  prompt            String?     @db.Text
  templateId        String?
  presetId          String?
  resolution        String      @default("1K")

  totalImages       Int         @default(1)
  count             Int         @default(1)
  completedImages   Int         @default(0)
  completedCount    Int         @default(0)
  failedImages      Int         @default(0)
  failedCount       Int         @default(0)

  creditsReserved   Int         @default(0)
  creditsUsed       Int         @default(0)

  status            BatchStatus @default(PENDING)
  errorMessage      String?

  prompts           Json?
  sharedSettings    Json?
  imageIds          String[]
  errors            Json?

  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("ic_BatchJob")
}

// =============================================================================
// REVIEWS
// =============================================================================

model Review {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating          Int
  title           String
  content         String    @db.Text
  useCase         String?

  isApproved      Boolean   @default(false)
  isPublic        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("ic_Review")
}

// =============================================================================
// WAITLIST
// =============================================================================

model WaitlistEntry {
  id                String   @id @default(cuid())
  email             String   @unique
  source            String?
  referralCode      String?

  interestedIn      String[]

  isInvited         Boolean  @default(false)
  invitedAt         DateTime?
  convertedToUser   Boolean  @default(false)

  createdAt         DateTime @default(now())

  @@index([email])
  @@index([isInvited])
  @@map("ic_WaitlistEntry")
}
